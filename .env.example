# --- SEGURIDAD MAESTRA ---
ADMIN_USER=admin
ADMIN_PASSWORD=cambiar_esta_clave_segura
JWT_SECRET=generar_hash_aleatorio_64_caracteres_hex_o_base64_muy_seguro
MASTER_API_KEY=sk_live_privada_para_integraciones

# --- INFRAESTRUCTURA Y TÚNEL ---
APP_PORT=3000
DASHBOARD_PORT=5176
TZ=America/Argentina/Buenos_Aires
CLOUDFLARE_TUNNEL_TOKEN=

# --- BASE DE DATOS Y REDIS ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_pass_2026
POSTGRES_DB=mejoraws
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres_secure_pass_2026@postgres:5432/mejoraws

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# --- MOTOR WHATSAPP (EVOLUTION API INTERNA) ---
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_API_KEY=evo_internal_secret_key_2026
INSTANCE_NAME=principal_v1

# --- PROTECCIÓN ANTI-BANEO Y COLAS ---
ENFORCE_WHITELIST=true
JITTER_MIN_SECONDS=4
JITTER_MAX_SECONDS=12
BATCH_PAUSE_EVERY_N_MESSAGES=15
BATCH_PAUSE_SECONDS=60
SAFE_HOURS_START=08:30
SAFE_HOURS_END=20:30
MAX_MESSAGES_PER_HOUR=120

# --- INTELIGENCIA ARTIFICIAL (RETENCIÓN Y HANDOFF) ---
AI_PROVIDER=openai # openai | gemini | anthropic
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_AUTO_MUTE_HOURS_ON_HUMAN_REPLY=24
OWNER_ALERT_WEBHOOK_URL=
