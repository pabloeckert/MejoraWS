{
  "name": "mejora-contacto",
  "version": "0.1.0",
  "description": "Envio personalizado de WhatsApp a contactos conocidos, con monitoreo en tiempo real. Uso personal, no bulk.",
  "type": "module",
  "main": "electron/main.mjs",
  "author": "Pablo - Mejora Continua",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev:renderer": "vite",
    "dev:electron": "wait-on http://localhost:5173 && electron .",
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "build": "vite build",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "baileys": "7.0.0-rc14",
    "lowdb": "^7.0.1",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.4",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "papaparse": "^5.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.0",
    "wait-on": "^9.1.0",
    "xlsx": "^0.18.5"
  },
  "build": {
    "appId": "com.mejoracontinua.mejoracontacto",
    "productName": "MejoraContacto",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "protocols": [
      {
        "name": "MejoraWS",
        "schemes": ["mejoraws"]
      }
    ],
    "win": {
      "target": "nsis"
    }
  }
}
